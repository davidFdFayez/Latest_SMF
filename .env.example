# Copy to .env beside docker-compose.yml and fill in. .env is ignored by git
# and must stay that way: this repository is public.
#
#   cp .env.example .env
#
# Generate the signing key with something that is not a person's idea of a
# random string:
#
#   openssl rand -base64 48
#
# Changing it signs every open session out, which is the point when it has
# been exposed.
JWT_SECRET=

# Only read when the database has no administrator at all — on a first
# start, or after a restore. Leave it empty afterwards.
SEED_ADMIN_PASSWORD=
