<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Smf.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The production sources, linked rather than copied, so these tests can
      never drift from the code they are about. Both are pure logic with no
      database and no API, which is why they can be linked at all.
    -->
    <Compile Include="../../backend/Smf.Api/Services/DrawBuilder.cs" Link="DrawBuilder.cs" />
    <Compile Include="../../backend/Smf.Api/Services/BoutScheduler.cs" Link="BoutScheduler.cs" />
    <Compile Include="../../backend/Smf.Api/Data/Models/BoutRounds.cs" Link="BoutRounds.cs" />
    <Compile Include="../../backend/Smf.Api/Data/WeightClasses.cs" Link="WeightClasses.cs" />

    <Compile Include="DrawTests.cs" />
    <Compile Include="ScheduleTests.cs" />
    <Compile Include="WeightClassTests.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
