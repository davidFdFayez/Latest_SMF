      "refPrefixLabel": { "ar": "رمز الطلب:", "en": "Reference prefix:" },
      "buttonLabel": { "ar": "سجّل الآن", "en": "Register Now" },
      "items": [
        {
          "image": "/assets/images/reg-athlete.svg",
          "prefix": "SMF-A",
          "title": { "ar": "تسجيل لاعب", "en": "Athlete Registration" },
          "description": {
            "ar": "سجّل بياناتك كرياضي لدى الاتحاد السعودي للملاكمة التايلندية.",
            "en": "Submit your official registration as a Muaythai athlete with the Saudi Muaythai Federation (SMF)."
          },
          "url": "/registration/athlete"
        },
        {
          "image": "/assets/images/reg-club.svg",
          "prefix": "SMF-C",
          "title": { "ar": "تسجيل نادي", "en": "Club Registration" },
          "description": {
            "ar": "سجّل ناديك أو مركزك التدريبي رسمياً لدى الاتحاد.",
            "en": "Register your Muaythai club or training centre officially with the federation."
          },
          "url": "/registration/club"
        },
        {
          "image": "/assets/images/reg-coach.svg",
          "prefix": "SMF-T",
          "title": { "ar": "تسجيل مدرب", "en": "Coach Registration" },
          "description": {
            "ar": "سجّل بياناتك للحصول على ترخيص التدريب من الاتحاد.",
            "en": "Submit your official application for a coaching licence from the federation."
          },
          "url": "/registration/coach"
        },
        {
          "image": "/assets/images/reg-official.svg",
          "prefix": "SMF-O",
          "title": { "ar": "تسجيل حكم / مسؤول", "en": "Official Registration" },
          "description": {
            "ar": "سجّل بياناتك كحكم أو مسؤول رسمي لدى الاتحاد.",
            "en": "Register as a referee, judge, or official with the Saudi Muaythai Federation (SMF)."
          },
          "url": "/registration/official"
        }
      ]
