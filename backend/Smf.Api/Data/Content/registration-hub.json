        { "value": "13", "label": { "ar": "منطقة نشطة", "en": "Active Regions" } },
        { "value": "2019", "label": { "ar": "عام التأسيس", "en": "Founded" } }
      ]
    },
    "steps": {
      "label": { "ar": "كيف يعمل", "en": "How it Works" },
      "heading": { "ar": "كيف تسير العملية", "en": "How It Works" },
      "items": [
        {
          "number": "1",
          "title": { "ar": "أكمل النموذج", "en": "Complete the Form" },
          "text": {
            "ar": "اختر نوع التسجيل المناسب وأدخل بياناتك بدقة.",
            "en": "Select your registration type and enter your details accurately."
          }
        },
        {
          "number": "2",
          "title": { "ar": "استلم الرقم المرجعي", "en": "Receive Reference Number" },
          "text": {
            "ar": "يصدر رقم مرجعي فور إرسال الطلب لمتابعة حالته.",
            "en": "A reference number is issued immediately upon submission to track your application."
          }
        },
        {
          "number": "3",
          "title": { "ar": "مراجعة الاتحاد", "en": "SMF Review" },
          "text": {
            "ar": "يراجع فريق الاتحاد طلبك والوثائق المرفقة.",
            "en": "The federation team reviews your application and supporting documents."
          }
        },
        {
          "number": "4",
          "title": { "ar": "إشعار بالقرار", "en": "Decision Notification" },
          "text": {
            "ar": "تصلك النتيجة رسمياً وتستطيع استلام وثائق التسجيل.",
            "en": "You receive the official outcome and can collect your registration documents."
          }
        }
      ]
    },
    "types": {
      "label": { "ar": "التسجيل", "en": "Registration" },
      "heading": { "ar": "اختر نوع التسجيل", "en": "Choose Your Registration Type" },
      "note": {
        "ar": "هذا النموذج تسجيل رسمي لدى الاتحاد. سيُحفظ طلبك وستتلقى رقماً مرجعياً فور الإرسال.",
