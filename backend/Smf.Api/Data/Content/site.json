        "en": "Riyadh, Al Rafiah District, Al Diwan St., Prince Faisal bin Fahd Olympic Complex"
      },
      "workingHours": { "ar": "من الساعة 10 ص وحتى الساعة 6 م", "en": "10:00 AM – 6:00 PM" },
      "website": "www.saudimuaythai.sa"
    },
    "social": [
      { "platform": "whatsapp", "url": "https://wa.me/966552677377", "showInTopBar": true },
      { "platform": "x", "url": "https://x.com/smf_ksa", "showInTopBar": true },
      { "platform": "instagram", "url": "https://www.instagram.com/smf__ksa/", "showInTopBar": true },
      { "platform": "threads", "url": "https://www.threads.com/@smf__ksa", "showInTopBar": false },
      { "platform": "tiktok", "url": "https://www.tiktok.com/@smf.ksa", "showInTopBar": true },
      { "platform": "linkedin", "url": "https://sa.linkedin.com/company/saudimuaythai", "showInTopBar": true },
      { "platform": "snapchat", "url": "https://snapchat.com/t/d0QLDkXr", "showInTopBar": true },
      { "platform": "youtube", "url": "https://www.youtube.com/@SaudiMuayThaiFederation", "showInTopBar": true }
    ],
    "qrCodes": {
      "whatsapp": "/assets/images/qr-whatsapp.svg",
      "community": "/assets/images/qr-community.svg"
    },
    "partners": [
      { "name": { "ar": "وزارة الرياضة", "en": "Ministry of Sport" }, "logo": "/assets/images/partner-mos.png" },
      { "name": { "ar": "اللجنة الأولمبية والبارالمبية السعودية", "en": "Saudi Olympic & Paralympic Committee" }, "logo": "/assets/images/partner-sopc.jpg" },
      { "name": { "ar": "الاتحاد الدولي لجمعيات المواي تاي", "en": "International Federation of Muaythai Associations" }, "logo": "/assets/images/partner-ifma.webp" }
    ]
  }
}
